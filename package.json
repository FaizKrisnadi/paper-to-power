{
  "name": "paper-to-power",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "uv run python -m pipeline.sync_data",
    "fetch:grw": "uv run python3 -m pipeline.fetch_grw_release",
    "fetch:context": "uv run python3 -m pipeline.fetch_osm_context",
    "ingest:gem": "uv run python3 -m pipeline.ingest_gem",
    "ingest:grw": "uv run python3 -m pipeline.ingest_grw",
    "match:firstpass": "uv run python3 -m pipeline.match_projects",
    "export:geospatial": "uv run --extra geo python3 -m pipeline.export_geospatial_layers",
    "export:site-audit": "uv run --extra geo python3 -m pipeline.export_site_audit",
    "warehouse:build": "uv run --extra geo python3 -m pipeline.build_duckdb_warehouse",
    "score:context": "uv run --extra geo python3 -m pipeline.build_site_context",
    "import:deepresearch": "uv run python3 -m pipeline.import_deep_research_markdown",
    "import:registry-csv": "uv run python3 -m pipeline.import_registry_csv",
    "curate:deepresearch": "uv run python3 -m pipeline.curate_deep_research_seed",
    "prepare:seed-enrichment": "uv run python3 -m pipeline.prepare_seed_enrichment",
    "apply:seed-enrichment": "uv run python3 -m pipeline.apply_seed_enrichment",
    "promote:reviewed-seed": "uv run python3 -m pipeline.promote_reviewed_seed",
    "sync:data": "uv run python3 -m pipeline.sync_data",
    "build": "npm run build:data && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "refresh:registry": "uv run python -m pipeline.refresh_registry",
    "validate:data": "uv run python -m pipeline.validate_release",
    "test": "uv run --extra test --extra geo pytest",
    "build:research": "uv run --extra geo python -m pipeline.build_research_outputs"
  },
  "dependencies": {
    "maplibre-gl": "^6.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
